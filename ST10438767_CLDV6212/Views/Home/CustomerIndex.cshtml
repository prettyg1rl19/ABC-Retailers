@model IEnumerable<ST10438767_CLDV6212.Models.Customer>

@{
    ViewData["Title"] = "Welcome";
}

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(to right, #f5f5f5, #e0d8c3);
        color: #2c2c2c;
    }

    .content {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 80vh;
        padding: 20px;
    }

    .card {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        padding: 40px;
        max-width: 600px;
        text-align: center;
        transition: transform 0.3s ease;
    }

        .card:hover {
            transform: scale(1.02);
        }

        .card h1 {
            font-size: 28px;
            margin-bottom: 20px;
            color: #3e2f1c;
        }

    .shop-button {
        background-color: #3e2f1c;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 14px 28px;
        font-size: 18px;
        cursor: pointer;
        text-decoration: none;
        transition: background-color 0.3s ease;
    }

        .shop-button:hover {
            background-color: #5a4428;
        }
</style>

<div class="content">
    <div class="card">
        <h1>You're in. Try not to blow your budget all at once, customer.</h1>
        <a class="shop-button" asp-area="" asp-controller="Customerview" asp-action="Shop">Enter the Shop</a>
    </div>
</div>
