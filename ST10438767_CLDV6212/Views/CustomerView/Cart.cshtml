@model List<ST10438767_CLDV6212.Models.CartItem>

@{
    ViewData["Title"] = "Your Cart";
}

<div class="d-flex">
    <div class="sidebar text-white p-3">
        <h4 class="mb-4">Menu</h4>
        <a asp-action="Dashboard" asp-controller="CustomerView" class="btn btn-outline-light w-100 mb-2 text-start">Dashboard</a>
        <a asp-action="Shop" asp-controller="CustomerView" class="btn btn-outline-light w-100 mb-2 text-start">Shop</a>
        <a asp-action="Cart" asp-controller="CustomerView" class="btn btn-outline-light w-100 mb-2 text-start">Cart</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-danger w-100 mt-3">Logout</a>
        <!--Toelsen, A., Japikse, P., 2022. Pro C# 10 with .NET 6. 11th ed. New York: Apress.-->
    </div>

    <div class="flex-grow-1 p-4" style="background-color: #1f2d3d;">
        <h2 class="text-light">@ViewData["Title"]</h2>

        @if (!Model.Any())
        {
            <div class="alert alert-info text-center">
                Your cart is empty. Go to the <a asp-action="Shop" class="text-decoration-underline">Shop</a> to add products.
            </div>
        }
        <!--Mrzygłód, K., 2022. Azure for Developers.-->
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm text-center" style="background-color: #2c3e50; color: #f8f9fa;">
                            <img src="@item.ImageUrl" class="card-img-top img-fluid rounded" alt="@item.ProductName" />
                            <div class="card-body">
                                <h5 class="card-title">@item.ProductName</h5>
                                <p class="card-text">Price: @item.Price.ToString("C")</p>
                                <p class="card-text">Qty: @item.Quantity</p>
                                <p class="card-text">Total: @(item.Price* item.Quantity).ToString("C")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <a asp-action="Checkout" asp-controller="CustomerView" class="btn btn-outline-light w-100 mb-2 text-start">Go to checkout</a>

        }
    </div>
</div>

<style>
    .sidebar {
        width: 160px;
        min-height: 100vh;
        background-color: rgba(207, 187, 153);
        border-right: 2px solid rgba(76, 61, 25);
    }

        .sidebar a.btn {
            border-color: rgba(229, 215, 196);
            color: #f8f9fa;
            background-color: transparent;
        }

            .sidebar a.btn:hover {
                background-color: rgba(136, 144, 99);
                color: #ffffff;
            }

    .bubble-btn {
        display: block;
        width: 100%;
        padding: 15px;
        margin-top: 15px;
        border-radius: 50px;
        font-weight: bold;
        text-decoration: none;
        transition: all 0.4s ease;
        border: none;
        box-shadow: 0 0 15px rgba(76, 61, 25, 0.15);
        position: relative;
        text-align: center;
        background-color: rgba(136, 144, 99);
        color: white;
    }

        .bubble-btn:hover {
            transform: scale(1.05);
            filter: brightness(1.3) saturate(1.4) hue-rotate(20deg);
            box-shadow: 0 0 25px rgba(76, 61, 25, 0.4), inset 0 0 10px rgba(76, 61, 25, 0.3);
            background-color: #34d058;
        }

        .bubble-btn:active {
            transform: scale(0.97);
        }
</style>
<!--Mrzygłód, K., 2022. Azure for Developers.-->
