@model IEnumerable<ST10438767_CLDV6212.Models.Order>

@{
    ViewData["Title"] = "Index";
}

<style>
    body {
        height: 200px;
        background-image: linear-gradient(to bottom right, rgba(207, 187, 153), rgba(229, 215, 196));
    }
</style>

<header style="background-color:rgba(136, 144, 99)">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3" style="background-color:rgba(136, 144, 99)">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ABC Retailers</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" style="background-color:rgba(136, 144, 99)">
                <ul class="navbar-nav flex-grow-1" style="background-color:rgba(136, 144, 99)">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Customer" asp-action="Index">Customer Data</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Product" asp-action="Index">Product Inforation</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Order" asp-action="Index">Order Details</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Files" asp-action="Index">Documentation</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-danger w-100 mt-3">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<h1 style="color:rgba(53, 64, 36); font-family:'Times New Roman', Times, serif">List of Orders</h1>

<p>
    <a asp-action="AddOrder"
       style="font-family:'Times New Roman', Times, serif;
           color: rgba(76, 61, 25)">Place an Order</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Order_Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Timestamp)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Customer_Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Product_ID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Delivery_Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Delivery_Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order_Status)
            </th>
            <th>
                Action
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Order_Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Timestamp)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer_Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Product_ID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Delivery_Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Delivery_Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Order_Status)
            </td>
            <td>
                <form asp-action="DeleteOrder" method="post" style="display:inline">
                    <input type="hidden" name="partitionKey" value="@item.PartitionKey" />
                    <input type="hidden" name="rowKey" value="@item.RowKey" />
                    <button type="submit"
                            style="font-family:'Times New Roman', Times, serif; color: rgba(72, 25, 17)"
                            class="btn btn-danger"
                            onclick="return confirm('Are sure you want to delete this Order?');">
                        Delete Order
                    </button>
                </form>
            </td>
                <td>
                    <form asp-action="EditOrder" method="post" style="display:inline">
                        <input type="hidden" name="partitionKey" value="@item.PartitionKey" />
                        <input type="hidden" name="rowKey" value="@item.RowKey" />
                        <button type="submit"
                                style="font-family:'Times New Roman', Times, serif; background-color: rgba(136, 144, 99)"
                                class="btn btn-danger"
                                onclick="return confirm('Are sure you want to Edit this Order?');">
                            Edit Order
                        </button>
                    </form>
                </td>
        </tr>
}
    </tbody>
</table>
