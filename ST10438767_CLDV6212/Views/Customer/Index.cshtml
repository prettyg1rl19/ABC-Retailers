@model IEnumerable<ST10438767_CLDV6212.Models.Customer>

@{
    ViewData["Title"] = "Index";
}

<style>
    body {
        height: 200px;
        background-image: linear-gradient(to bottom right, rgba(207, 187, 153), rgba(229, 215, 196));
    }

    #myInput 
    {
        background-image: url(https://www.google.com/url?sa=i&url=https%3A%2F%2Fwww.dreamstime.com%2Foutline-search-icon-vector-illustration-isolated-transparent-background-sign-symbol-black-white-style-image207070400&psig=AOvVaw2PTkrXdKhjhM_taiBkynkq&ust=1755795810749000&source=images&cd=vfe&opi=89978449&ved=0CBUQjRxqFwoTCKDIw5_vmY8DFQAAAAAdAAAAABAE);
        background-position: 10px 10px;
        background-repeat: no-repeat;
        width: 100%;
        font-size: 16px;
        padding: 12px 20px 12px 40px;
        border: 1px solid rgba(207, 187, 153);
        margin-bottom: 12px;
    }
</style>

<!--
    w3schools, 2025. Create A Filtered Table
    [online] Available at: <https://www.w3schools.com/howto/howto_js_filter_table.asp > [Accessed 20 August 2025].
-->

<script>
    function myFunction() {
      var input, filter, table, tr, td, i, txtValue;
      input = document.getElementById("myInput");
      filter = input.value.toUpperCase();
      table = document.getElementById("table");
      tr = table.getElementsByTagName("tr");
      for (i = 0; i < tr.length; i++) {
        td = tr[i].getElementsByTagName("td")[0];
        if (td) {
          txtValue = td.textContent || td.innerText;
          if (txtValue.toUpperCase().indexOf(filter) > -1) {
            tr[i].style.display = "";
          } else {
            tr[i].style.display = "none";
          }
        }
      }
    }
</script>

<header style="background-color:rgba(136, 144, 99)">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3" style="background-color:rgba(136, 144, 99)">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ABC Retailers</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" style="background-color:rgba(136, 144, 99)">
                <ul class="navbar-nav flex-grow-1" style="background-color:rgba(136, 144, 99)">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Customer" asp-action="Index">Customer Data</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Product" asp-action="Index">Product Inforation</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Order" asp-action="Index">Order Details</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Files" asp-action="Index">Documentation</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-danger w-100 mt-3">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<h1 style="color:rgba(53, 64, 36); font-family:'Times New Roman', Times, serif">List of Customers</h1>

<p>
    <a asp-action="AddCustomer" 
    style="font-family:'Times New Roman', Times, serif; color: rgba(76, 61, 25)">Add a new Customer</a>
</p>

<input type="text"
       id="myInput"
       onkeyup="myFunction()"
       placeholder="Search for a customer..."
       style="font-family:'Times New Roman', Times, serif; color:rgba(76, 61, 25); background-color:rgba(229, 215, 196)">
<!--
    w3schools, 2025. Create A Filtered Table
    [online] Available at: <https://www.w3schools.com/howto/howto_js_filter_table.asp > [Accessed 20 August 2025].
-->

<table class="table" id="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Customer_Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Customer_Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Customer_Address)
            </th>
            <th>
                Action
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Customer_Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer_Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer_Address)
            </td>
            <td>
                    <form asp-action="DeleteCustomer" method="post" style="display:inline">
                        <input type="hidden" name="partitionKey" value="@item.PartitionKey" />
                        <input type="hidden" name="rowKey" value="@item.RowKey" />
                        <button type="submit" 
                                style="font-family:'Times New Roman', Times, serif; color: rgba(72, 25, 17)" 
                                class="btn btn-danger" 
                                onclick="return confirm('Are sure you want to delete this Customer?');">Delete Customer</button>
                    </form>
            </td>
            <td>
                <form asp-action="EditCustomer" method="post" style="display:inline">
                    <input type="hidden" name="partitionKey" value="@item.PartitionKey" />
                    <input type="hidden" name="rowKey" value="@item.RowKey" />
                    <button type="submit" 
                            style="font-family:'Times New Roman', Times, serif; background-color: rgba(136, 144, 99)" 
                            class="btn btn-danger" 
                            onclick="return confirm('Are sure you want to Edit this Customer?');">Edit Customer</button>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>
